{
  "name": "life-clock",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "deploy": "bun run build && wrangler deploy",
    "postinstall": "if [ -n \"$CLOUDFLARE_API_TOKEN\" ] || [ -n \"$CF_API_TOKEN\" ]; then bun run build; fi",
    "test:e2e": "bun test/e2e/focus-e2e.ts",
    "test:e2e:features": "bun test/e2e/features-e2e.ts",
    "test:e2e:loading": "bun test/e2e/loading-refresh-e2e.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "mobile:sync": "bun run mobile:build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8",
    "@cloudflare/workers-types": "^4.20260615.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.0.2",
    "wrangler": "^4.123.0"
  }
}
